PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/spotify-tracker
SESSION_SECRET=your-super-secret-session-key-change-this

# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Dual redirect support
# - Mobile (PKCE deep link)
SPOTIFY_REDIRECT_URI_MOBILE=ratesangeet://callback
# - Web/Server (confidential flow)
SPOTIFY_REDIRECT_URI_WEB=http://127.0.0.1:5000/api/auth/callback

# Backward-compat: default redirect if neither target specified
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/auth/callback

# For mobile development
CLIENT_URL=http://127.0.0.1:8081
