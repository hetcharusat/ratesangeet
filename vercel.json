{
  "name": "ratesangeet",
  "buildCommand": "cd mobile && npm install && npx expo export -p web",
  "outputDirectory": "mobile/dist",
  "devCommand": "cd mobile && npm run web",
  "installCommand": "cd mobile && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
