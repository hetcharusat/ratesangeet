{
  "name": "spotify-tracker-server",
  "version": "1.0.0",
  "description": "Backend API for Spotify Music Tracker",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:smoke": "node test/music-envelope.test.mjs",
    "test": "npm run test:smoke",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "gen:types": "openapi-typescript openapi.yaml -o ../shared/api-types.ts",
    "job:archive": "tsx src/jobs/archiveScrobbles.ts",
    "admin:mark-revoked": "tsx src/scripts/mark-revoked-users.ts",
    "admin:mark-revoked:apply": "tsx src/scripts/mark-revoked-users.ts --apply",
    "admin:reset-seed": "tsx src/scripts/reset-and-seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "mongoose": "^8.1.0",
    "node-cache": "^5.1.2",
    "react-native-paper": "^5.14.5",
    "react-native-vector-icons": "^10.3.0",
    "spotify-music-tracker": "file:..",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.17.10",
    "@types/node": "^20.11.5",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yamljs": "^0.3.4",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "openapi-typescript": "^7.10.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
